      m_Calls: []
  m_text: "One day you come across some kind of anomaly, your curiosity gets the
    better of you. You head towards it and avocado into the murky mists.. Some writing
    begins to take shape and you catch a glimpse of a few words: \n<color=#91DD8F>Buffer
    overflow imminent... 41.9Qi/42.0Qi.</color> \nThe number ticks over and everything
    goes black..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 34bc7e54620b8d34d88b7e42acd6b463, type: 2}
