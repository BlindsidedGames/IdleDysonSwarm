{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idle-dyson-swarm-simulation-parity-fixture",
  "title": "Idle Dyson Swarm simulation parity fixture",
  "type": "object",
  "required": [
    "name",
    "source",
    "initialState",
    "commands",
    "elapsedMilliseconds",
    "expectedState"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "source": { "const": "unity-golden-master" },
    "initialState": { "type": "object" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atMilliseconds", "kind"],
        "properties": {
          "atMilliseconds": { "type": "number", "minimum": 0 },
          "kind": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "elapsedMilliseconds": { "type": "number", "minimum": 0 },
    "expectedState": { "type": "object" },
    "tolerances": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  },
  "additionalProperties": false
}
