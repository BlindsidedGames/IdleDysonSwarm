{
  "name": "idle-dyson-swarm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:performance": "tsc -b && vite build --mode performance",
    "report:initial-request-bundle": "npm run build && tsx scripts/report-initial-request-bundle.ts",
    "verify:normal-performance-build": "npm run report:initial-request-bundle && tsx scripts/performance/assertNormalBuildExcludesCommitProbe.ts",
    "report:performance:interaction": "npm run build:performance && tsx scripts/performance/runInteractionReport.ts",
    "report:performance:interaction:smoke": "npm run build:performance && tsx scripts/performance/runInteractionReport.ts --smoke",
    "report:performance:soak": "npm run build && tsx scripts/performance/runSoakReport.ts",
    "report:performance:soak:smoke": "npm run build && tsx scripts/performance/runSoakReport.ts --smoke",
    "data:export": "tsx scripts/export-unity-data.ts",
    "data:check": "tsx scripts/export-unity-data.ts --check",
    "parity:first-dyson:generate": "tsx scripts/generate-first-dyson-slice-fixture.ts",
    "parity:first-dyson:check": "tsx scripts/generate-first-dyson-slice-fixture.ts --check",
    "decode-save": "tsx scripts/decode-save.ts",
    "prepare-save": "tsx scripts/prepare-save.ts",
    "i18n:extract": "formatjs extract \"src/ui/**/*.{ts,tsx}\" --out-file src/ui/i18n/catalogs/source/en.json --throws",
    "i18n:compile": "npm run i18n:compile:en && npm run i18n:compile:en-xa && npm run i18n:compile:ar-xb",
    "i18n:compile:en": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/en.json --ast",
    "i18n:compile:en-xa": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/en-XA.json --ast --pseudo-locale en-XA",
    "i18n:compile:ar-xb": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/ar-XB.json --ast --pseudo-locale en-XB",
    "i18n:check": "npm run i18n:extract && npm run i18n:compile",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^10.1.18"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.14",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
