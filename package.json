{
  "name": "idle-dyson-swarm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "hosts/electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:stripe": "vite --mode development-stripe",
    "build": "tsc -b && vite build && tsx scripts/check-production-store-boundary.ts",
    "native:release:sync": "tsx scripts/sync-native-release.ts",
    "release:local": "tsx scripts/run-local-release.ts",
    "native:branding:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-native-branding.ps1",
    "build:native": "npm run native:release:sync && tsc -b && vite build --mode native",
    "native:capacitor:sync": "npm run build:native && npm --prefix hosts/capacitor run sync",
    "native:capacitor:sync:android": "npm run build:native && npm --prefix hosts/capacitor run sync:android",
    "native:capacitor:sync:ios": "npm run build:native && npm --prefix hosts/capacitor run sync:ios",
    "native:electron": "npm run build:native && electron hosts/electron/main.mjs",
    "native:electron:check": "node --check hosts/electron/main.mjs && node --check hosts/electron/smokeMode.mjs && node --check hosts/electron/preload.cjs",
    "native:electron:smoke": "npm run build:native && electron hosts/electron/main.mjs --smoke-test",
    "native:electron:smoke:suspend-resume": "npm run build:native && electron hosts/electron/main.mjs --suspend-resume-smoke",
    "native:electron:package:dir": "npm run build:native && electron-builder --config hosts/electron/electron-builder.yml --dir",
    "native:electron:package:windows": "npm run build:native && electron-builder --config hosts/electron/electron-builder.yml --win",
    "native:electron:package:macos": "npm run build:native && electron-builder --config hosts/electron/electron-builder.yml --mac",
    "native:electron:package:linux": "npm run build:native && electron-builder --config hosts/electron/electron-builder.yml --linux",
    "build:performance": "tsc -b && vite build --mode performance",
    "report:initial-request-bundle": "npm run build && tsx scripts/report-initial-request-bundle.ts",
    "report:bundle-composition": "tsx scripts/report-bundle-composition.ts",
    "verify:normal-performance-build": "npm run report:initial-request-bundle && tsx scripts/performance/assertNormalBuildExcludesCommitProbe.ts",
    "report:performance:interaction": "npm run build:performance && tsx scripts/performance/runInteractionReport.ts",
    "report:performance:interaction:smoke": "npm run build:performance && tsx scripts/performance/runInteractionReport.ts --smoke",
    "report:performance:mobile-long-tasks": "vite build --config scripts/performance/laneAttributionViteConfig.ts --mode performance && tsx scripts/performance/runMobileLongTaskAttribution.ts",
    "report:performance:lanes": "vite build --config scripts/performance/laneAttributionViteConfig.ts --mode performance && tsx scripts/performance/runLaneAttributionReport.ts",
    "report:performance:lanes:focused": "vite build --config scripts/performance/laneAttributionViteConfig.ts --mode performance && tsx scripts/performance/runLaneAttributionReport.ts --focused",
    "report:performance:matrix": "vite build --config scripts/performance/laneAttributionViteConfig.ts --mode performance && tsx scripts/performance/runProgressionMatrixReport.ts",
    "report:performance:matrix:smoke": "vite build --config scripts/performance/laneAttributionViteConfig.ts --mode performance && tsx scripts/performance/runProgressionMatrixReport.ts --smoke",
    "report:performance:stored-time-matrix": "tsx scripts/performance/runStoredTimeMatrixReport.ts",
    "report:performance:skill-effects": "tsx scripts/performance/runSkillEffectEvaluationReport.ts",
    "verify:performance:skill-effects": "vitest run src/simulation/skillEffectOptimizationCertification.test.ts && tsx scripts/performance/runSkillEffectEvaluationReport.ts --assert",
    "report:performance:soak": "npm run build && tsx scripts/performance/runSoakReport.ts",
    "report:performance:soak:smoke": "npm run build && tsx scripts/performance/runSoakReport.ts --smoke",
    "verify:web-accessibility:browser": "npm run build:performance && tsx scripts/performance/runWebAccessibilityAcceptance.ts",
    "verify:number-typography:browser": "tsx scripts/verify-tabular-number-rendering.ts",
    "verify:localization:browser": "npm run build && tsx scripts/run-localization-visual-audit.ts",
    "verify:localization:contact-sheets": "tsx scripts/create-localization-contact-sheets.ts",
    "pwa:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-pwa-icons.ps1",
    "verify:pwa:production": "tsx scripts/verify-pwa-production.ts",
    "verify:pwa:candidate": "tsx scripts/verify-pwa-production.ts --output=output/performance/pwa-production-candidate.json",
    "website:promotion:prepare": "tsx scripts/prepare-website-promotion.ts",
    "website:promotion:apply": "tsx scripts/apply-website-promotion.ts",
    "data:export": "tsx scripts/build-web-data.ts",
    "data:check": "tsx scripts/build-web-data.ts --check",
    "parity:first-dyson:generate": "tsx scripts/generate-first-dyson-slice-fixture.ts",
    "parity:first-dyson:check": "tsx scripts/generate-first-dyson-slice-fixture.ts --check",
    "decode-save": "tsx scripts/decode-save.ts",
    "prepare-save": "tsx scripts/prepare-save.ts",
    "fixtures:progression:generate": "tsx scripts/generate-progression-fixtures.ts",
    "i18n:extract": "formatjs extract \"src/ui/**/*.{ts,tsx}\" \"src/pwa/**/*.{ts,tsx}\" --out-file src/ui/i18n/catalogs/source/en.json --throws && tsx scripts/merge-skill-messages-into-source-catalog.ts && tsx scripts/merge-wiki-authored-content-into-source-catalog.ts",
    "i18n:skills:check": "tsx scripts/merge-skill-messages-into-source-catalog.ts --check",
    "i18n:wiki:check": "tsx scripts/merge-wiki-authored-content-into-source-catalog.ts --check",
    "i18n:translations:check": "tsx scripts/check-translation-catalogs.ts",
    "i18n:compile": "npm run i18n:compile:en && npm run i18n:compile:fr && npm run i18n:compile:de && npm run i18n:compile:es-419 && npm run i18n:compile:pt-br && npm run i18n:compile:zh-cn && npm run i18n:compile:ru && npm run i18n:compile:ja && npm run i18n:compile:en-xa && npm run i18n:compile:ar-xb",
    "i18n:compile:en": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/en.json --ast",
    "i18n:compile:fr": "formatjs compile src/ui/i18n/catalogs/translations/fr.json --format simple --out-file src/ui/i18n/catalogs/compiled/fr.json --ast",
    "i18n:compile:de": "formatjs compile src/ui/i18n/catalogs/translations/de.json --format simple --out-file src/ui/i18n/catalogs/compiled/de.json --ast",
    "i18n:compile:es-419": "formatjs compile src/ui/i18n/catalogs/translations/es-419.json --format simple --out-file src/ui/i18n/catalogs/compiled/es-419.json --ast",
    "i18n:compile:pt-br": "formatjs compile src/ui/i18n/catalogs/translations/pt-BR.json --format simple --out-file src/ui/i18n/catalogs/compiled/pt-BR.json --ast",
    "i18n:compile:zh-cn": "formatjs compile src/ui/i18n/catalogs/translations/zh-CN.json --format simple --out-file src/ui/i18n/catalogs/compiled/zh-CN.json --ast",
    "i18n:compile:ru": "formatjs compile src/ui/i18n/catalogs/translations/ru.json --format simple --out-file src/ui/i18n/catalogs/compiled/ru.json --ast",
    "i18n:compile:ja": "formatjs compile src/ui/i18n/catalogs/translations/ja.json --format simple --out-file src/ui/i18n/catalogs/compiled/ja.json --ast",
    "i18n:compile:en-xa": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/en-XA.json --ast --pseudo-locale en-XA",
    "i18n:compile:ar-xb": "formatjs compile src/ui/i18n/catalogs/source/en.json --out-file src/ui/i18n/catalogs/compiled/ar-XB.json --ast --pseudo-locale en-XB",
    "i18n:check": "npm run i18n:extract && npm run i18n:translations:check && npm run i18n:compile",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "native:steam:build": "node scripts/build-steam-native.mjs",
    "native:steam:package:macos": "VITE_IDS_DESKTOP_DISTRIBUTION=steam npm run build:native && electron-builder --config hosts/electron/electron-builder.yml --mac --config.extraMetadata.idsDesktopDistribution=steam"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/splash-screen": "8.0.2",
    "@noble/hashes": "2.2.0",
    "fflate": "^0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^10.1.18"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@formatjs/cli": "^6.16.14",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
